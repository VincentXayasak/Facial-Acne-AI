# Copy to .env and adjust for your LM Studio setup.
# In LM Studio: load an embedding model, start the server, note the model id on the server tab.

# Host only is fine; /v1 is appended automatically if missing.
LM_STUDIO_BASE_URL=http://localhost:1234
LM_STUDIO_API_KEY=lm-studio
LM_STUDIO_EMBED_MODEL=text-embedding-nomic-embed-text-v1.5

CHROMA_PATH=./chroma_db
COLLECTION_NAME=acne_research

MARKDOWN_DIR=./markdown
MANIFEST_PATH=./markdown/manifest.json

# Vision + chat model in LM Studio (Qwen2.5-VL 7B)
LM_STUDIO_CHAT_MODEL=qwen/qwen2.5-vl-7b
LM_STUDIO_MAX_TOKENS=3072

# Max cosine distance for a retrieved chunk (lower = stricter). Try 0.24 if still off-topic.
RAG_MAX_DISTANCE=0.28
